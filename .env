# ---------------------------------------------------------------------------------------------
# Backend gates — which domains read the local Postgres instead of fixtures.
#
# USE_MOCKS is NOT set here on purpose: `npm run dev` and `npm run dev:mock` pass it as a task
# env prefix, and that prefix beats this file (dotenv load({export:true}) never overwrites a
# variable the process already has). Setting it here would fight the scripts.
#
# Reality check: only AuthBackendService, UserBackendService and ContextBackendService contain a
# real Supabase call today. The other gates below are armed but their services still fall through
# to fixtures, so flipping them changes nothing until the live branch is written. See
# API_BACKLOG.md and packages/backend/mocks/registry.ts (`liveImplemented`).
# ---------------------------------------------------------------------------------------------
EXPLORE_BACKEND_LIVE="true"
PROFILE_BACKEND_LIVE="true"
PROJECTS_BACKEND_LIVE="true"
MESSAGING_BACKEND_LIVE="true"
CATALOGUE_BACKEND_LIVE="true"
NEWSLETTER_BACKEND_LIVE="true"
WORKSPACE_BACKEND_LIVE="true"
FINANCE_BACKEND_LIVE="true"
FILES_BACKEND_LIVE="true"
LOGGING_BACKEND_LIVE="true"
INTEGRATIONS_BACKEND_LIVE="false"
