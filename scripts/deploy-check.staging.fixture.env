# A complete staging env for scripts/deploy-check.test.ts. Every value is fake and shaped so no
# secret scanner mistakes it for a key. `deno task deploy:check --target staging` passes on it.
DENO_ENV=production
APP_URL=https://staging.example.com
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=fixture-anon-key-not-a-jwt
SUPABASE_SERVICE_ROLE_KEY=fixture-service-role-key-not-a-jwt

AUTH_BACKEND_LIVE=true
EXPLORE_BACKEND_LIVE=true
NEWSLETTER_BACKEND_LIVE=true
EDITORIAL_BACKEND_LIVE=true
COMMUNITY_BACKEND_LIVE=true
CONTACT_BACKEND_LIVE=true
PROJECTS_BACKEND_LIVE=true
MESSAGING_BACKEND_LIVE=true
CATALOGUE_BACKEND_LIVE=true
LOGGING_BACKEND_LIVE=true
FINANCE_BACKEND_LIVE=true
FILES_BACKEND_LIVE=true
INTEGRATIONS_BACKEND_LIVE=true
EMBEDDINGS_ENABLED=false
USE_MOCKS=false

STRIPE_SECRET_KEY=rk_test_fixture-not-a-real-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_fixture-not-a-real-key
STRIPE_WEBHOOK_SECRET=whsec_fixture-account-not-a-real-secret
STRIPE_THIN_WEBHOOK_SECRET=whsec_fixture-thin-not-a-real-secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_fixture-connect-not-a-real-secret

FINANCE_CRON_SECRET=fixture-finance-bearer-0000000000000000
ACCOUNT_CRON_SECRET=fixture-account-bearer-0000000000000000
SCHEDULING_CRON_SECRET=fixture-scheduling-bearer-0000000000000
CONTACT_CRON_SECRET=fixture-contact-bearer-0000000000000000
INTEGRATIONS_CRON_SECRET=fixture-integrations-bearer-00000000000
SEARCH_CRON_SECRET=fixture-search-bearer-00000000000000000
OPS_CRON_SECRET=fixture-ops-bearer-00000000000000000000
COMMS_DISPATCH_SECRET=fixture-dispatch-bearer-000000000000000

ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

RESEND_API_KEY=re_fixture-not-a-real-key
