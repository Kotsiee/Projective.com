{
	"name": "@projective/types",
	"version": "0.1.0",
	"description": "Projective Zod SSOT — the single source of truth for data shapes shared across the app, the @projective/backend services, and the database docs. A migration lands with its matching schema here (documentation/database/CLAUDE.md, The Zod SSOT Rule).",
	"exports": {
		".": "./mod.ts",
		"./analytics": "./analytics/mod.ts",
		"./auth": "./auth/mod.ts",
		"./org": "./org/mod.ts",
		"./finance": "./finance/mod.ts",
		"./explore": "./explore/mod.ts",
		"./explore/limits": "./explore/limits.ts",
		"./files": "./files/mod.ts",
		"./integrations": "./integrations/mod.ts",
		"./links": "./links/mod.ts",
		"./catalogue": "./catalogue/mod.ts",
		"./comms": "./comms/mod.ts",
		"./contact": "./contact/mod.ts",
		"./content": "./content/mod.ts",
		"./content/fixtures": "./content/fixtures.ts",
		"./content/text": "./content/text.ts",
		"./newsletter": "./newsletter/mod.ts",
		"./community": "./community/mod.ts",
		"./community/feedback-constants": "./community/feedback-constants.ts",
		"./editorial": "./editorial/mod.ts",
		"./projects": "./projects/mod.ts",
		"./messaging": "./messaging/mod.ts",
		"./profile": "./profile/mod.ts",
		"./richtext": "./richtext/mod.ts",
		"./scheduling": "./scheduling/mod.ts",
		"./services": "./services/mod.ts",
		"./settings": "./settings/mod.ts",
		"./slugs": "./slugs/mod.ts",
		"./logging": "./logging/mod.ts",
		"./marketing": "./marketing/mod.ts",
		"./ops": "./ops/mod.ts",
		"./user": "./user/mod.ts",
		"./workspace": "./workspace/mod.ts"
	},
	"imports": {
		"zod": "npm:zod@^4.3.6"
	},
	"exclude": ["dist", "coverage"]
}
